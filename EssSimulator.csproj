<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>EssSimulator</RootNamespace>
    <AssemblyName>EssSimulator</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 前端构建产物由 wwwroot/ 静态托管；发布时一并复制 -->
    <!-- 排除发布产物，避免二次 publish 把 dist/ 内文件当源文件复制（MSB3030） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/dist/**;**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EssSimulator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="EssSimulator.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="NModbus" Version="3.0.81" />
    <PackageReference Include="CsvHelper" Version="32.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- ASP.NET Core / SignalR Server 由 Microsoft.NET.Sdk.Web 隐式提供，无需显式引用 -->
  </ItemGroup>

  <!-- libiec61850 .NET 包装（GPLv3）。Linux 原生库暂不随仓；osx / win-x64 见 lib61850/native。 -->
  <ItemGroup>
    <Reference Include="iec61850dotnet">
      <HintPath>$(MSBuildThisFileDirectory)lib61850/managed/iec61850dotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- 单文件发布必须 ExcludeFromSingleFile：否则会打进 bundle 的 runtimes/RID/native/，Windows 运行时找不到。 -->
    <None Include="lib61850/native/osx-arm64/libiec61850.dylib" Link="runtimes/osx-arm64/native/libiec61850.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Include="lib61850/native/osx-x64/libiec61850.dylib" Link="runtimes/osx-x64/native/libiec61850.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Include="lib61850/native/osx-universal/libiec61850.dylib" Link="runtimes/osx-universal/native/libiec61850.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Include="lib61850/native/win-x64/iec61850.dll" Link="runtimes/win-x64/native/iec61850.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>
  <!-- DllImport("iec61850") 默认只探 exe 同目录；单文件包再抄一份到发布根。 -->
  <Target Name="CopyWinIec61850DllBesideApp" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)lib61850/native/win-x64/iec61850.dll"
          DestinationFiles="$(OutputPath)iec61850.dll"
          SkipUnchangedFiles="true"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
  </Target>
  <Target Name="CopyWinIec61850DllBesidePublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)lib61850/native/win-x64/iec61850.dll"
          DestinationFiles="$(PublishDir)iec61850.dll"
          SkipUnchangedFiles="true"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
  </Target>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <!-- 设备型号点表：随输出/发布携带。选型型运行期可切换；LC 为 models/lc 片段拼装 -->
    <None Update="pointmaps/models/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Update="configs/ems-strategy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Update="autotest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <!-- 前端构建产物由 Microsoft.NET.Sdk.Web 默认作为 wwwroot 静态文件托管，无需显式声明 -->

</Project>
